{
  "manifest_version": 3,
  "name": "AutoSentinel AI - Antifraude Vehicular",
  "version": "1.1.0",
  "description": "Resalta vehículos con deudas o alertas en portales de venta.",
  "host_permissions": [
    "https://jado21.app.n8n.cloud/*","*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolibre.com.pe/*","*://*.facebook.com/marketplace/*"
      ],
      "js": ["content.js","detail.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
